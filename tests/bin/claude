#!/usr/bin/env bash
set -euo pipefail

launch_args=("$@")
model=""
flag_settings="{}"
probe=false
while [[ $# -gt 0 ]]; do
  case $1 in
    --model) model=$2; shift ;;
    --settings) flag_settings=$2; shift ;;
    --input-format) probe=true; shift ;;
  esac
  shift
done

if [[ $probe == false ]]; then
  printf '%s\0' "${launch_args[@]}" | jq -Rs 'split("\u0000")[:-1]' >"${FAKE_CLAUDE_LAUNCH:?}"
  exit
fi

resolve() {
  case $1 in
    "${FAKE_CLAUDE_UNRESOLVED:-}") printf '%s' "$1" ;;
    fable) printf claude-fable-5-1 ;;
    opus) printf claude-opus-5-5 ;;
  esac
}

model=$(resolve "$model")
while read -r request; do
  subtype=$(jq -r .request.subtype <<<"$request")
  case $subtype in
    set_model)
      requested=$(jq -r .request.model <<<"$request")
      [[ -n ${FAKE_CLAUDE_IGNORES_SWITCH:-} ]] || model=$(resolve "$requested")
      jq -cn --argjson request "$request" '{type: "control_response", response: {subtype: "success", request_id: $request.request_id}}' ;;
    get_settings)
      jq -cn \
        --argjson request "$request" \
        --arg model "$model" \
        --argjson user "${FAKE_USER_SETTINGS:-"{}"}" \
        --argjson flag "$flag_settings" \
        '{type: "control_response", response: {subtype: "success", request_id: $request.request_id, response: {
          applied: {model: $model},
          sources: [{source: "userSettings", settings: $user}, {source: "flagSettings", settings: $flag}]
        }}}' ;;
  esac
done
